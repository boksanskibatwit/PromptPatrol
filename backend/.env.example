# PromptPatrol Backend Environment Variables

# App
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# CORS comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Database ────────────────────────────────
# PostgreSQL connection string (at the top of the page press connect and look for connection string)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Supabase ────────────────────────────────
# Found in Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── JWT ─────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<your-jwt-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── AWS / S3 ────────────────────────────────
# IAM user credentials (never use root account credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# S3 bucket names — must match what you created in AWS
S3_BUCKET_REDACTED=promptpatrol-redacted
S3_BUCKET_AUDIT=promptpatrol-audit

# ─── ML Service (internal) ───────────────────
# URL of the ML service container (Docker Compose service name or ECS private DNS)
ML_SERVICE_URL=http://ml-service:8001
# Shared secret the backend sends to authenticate with the ML service
ML_SERVICE_SECRET=<generate-same-as-jwt-secret-approach>
