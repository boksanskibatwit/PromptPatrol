# Production build only. Vite loads this file in addition to .env during
# `npm run build` (production mode), and mode-specific values win — so this
# overrides the local-dev VITE_API_URL without touching .env. All other vars
# (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY) are inherited from .env.
#
# This MUST point at the deployed API Gateway backend (Lambda) — not localhost
# and not the CloudFront origin. If it's empty, admin/document API calls resolve
# to the frontend host and fail with a 503 HTML page.
VITE_API_URL=https://30zev1yw8g.execute-api.us-east-2.amazonaws.com
